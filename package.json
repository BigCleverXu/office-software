{
  "name": "reminder-app",
  "version": "2.11.0",
  "description": "桌面端效率工具：提醒、日历、行情、天气、热点、便签、文件搜索与快捷站点",
  "main": "./out/main/index.js",
  "author": "BigCleverXu",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/BigCleverXu/office-software",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "assets:fetch": "node scripts/fetch-asr-assets.mjs",
    "assets:check": "node scripts/fetch-asr-assets.mjs --check",
    "build:unpack": "pnpm run assets:check && pnpm run build && electron-builder --dir",
    "build:win": "pnpm run assets:check && pnpm run build && electron-builder --win",
    "build:mac": "pnpm run assets:check && pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-vue-next": "^1.0.0",
    "lunar-typescript": "^1.8.6",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.7.4",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.4",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "ffmpeg-static"
    ]
  }
}
